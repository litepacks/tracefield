{
  "name": "tracefield",
  "version": "0.0.1",
  "description": "High-performance Node.js & Edge security middleware, scanner probe detector, and honeypot deception engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tracefield": "./bin/tracefield.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "DISCLOSURE.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.cjs"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js",
      "require": "./dist/adapters/hono.cjs"
    },
    "./cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "import": "./dist/adapters/cloudflare.js",
      "require": "./dist/adapters/cloudflare.cjs"
    },
    "./analyzer": {
      "types": "./dist/analyzer/index.d.ts",
      "import": "./dist/analyzer/index.js",
      "require": "./dist/analyzer/index.cjs"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js",
      "require": "./dist/rules/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node benchmarks/run.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "middleware",
    "honeypot",
    "scanner-detector",
    "probe-detector",
    "decoy",
    "canary",
    "express",
    "hono",
    "cloudflare-workers",
    "waf",
    "defense"
  ],
  "author": "cond",
  "license": "MIT",
  "dependencies": {
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}